{
  "maxComplexity": 8,
  "maxParameters": 4,
  "maxNesting": 3,
  "allowedShortNames": [
    "id",
    "url",
    "api"
  ],
  "exemptNames": [
    "self",
    "_"
  ],
  "minNameLength": 3,
  "typescriptSuffixes": [
    ".ts",
    ".tsx",
    ".mts",
    ".cts",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs"
  ]
}
